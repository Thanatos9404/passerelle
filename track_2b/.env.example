# Copy to .env (never commit .env). docker compose and `make run` read it automatically.

# --- required by Hack Apertus: any OpenAI-compatible endpoint -----------------------------
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=changeme

# --- air-gapped mode (docker compose --profile local-llm up) ------------------------------
# LLM_NAME=apertus-8b
# LLM_BASE_URL=http://llm:8080/v1
# LLM_API_KEY=none
# LLM_GGUF=apertus-v1.5-8b-text-q4_k_m.gguf
# LLM_THREADS=8

# --- optional Passerelle settings -----------------------------------------------------------
# PASSERELLE_PORT=8080                 host port
# PASSERELLE_TIMEOUT=300               seconds per LLM request
# PASSERELLE_MAX_RETRIES=3
# PASSERELLE_TEMPERATURE=0.1
# PASSERELLE_SEED=7
# PASSERELLE_JSON_MODE=auto            auto | schema | object | off (response_format support of the endpoint)
# PASSERELLE_TASK_HEADER=1             send X-Passerelle-Task header (harmless; used by the mock server)
# PASSERELLE_EGRESS_ALLOW=             extra hosts the egress guard may reach (comma-separated)
# PASSERELLE_EGRESS_SOCKET_GUARD=1     process-wide socket guard (defence in depth)
# PASSERELLE_MAX_TOKENS_TRANSLATE=1400
# PASSERELLE_CORS_ORIGINS=http://localhost:3000
