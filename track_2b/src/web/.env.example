# Where the UI gets its data.
#   mock = in-browser mock layer (realistic DE/FR/IT letters, no backend needed)
#   api  = the FastAPI backend (SPEC section 2)
# Default: mock under `next dev`, api in production builds.
NEXT_PUBLIC_DATA_SOURCE=mock
# API origin. Empty = same origin (/api/*), which is how FastAPI serves the static export.
# For `next dev` against a local backend: http://localhost:8080
NEXT_PUBLIC_API_BASE=
